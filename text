15. Reverse a string without predefined functions or variables
There is a small issue with this question: you need some storage to build the reversed string, so "without variables" literally isn't practical in normal JavaScript.
If the interviewer means without built-in reverse functions such as .reverse(), use a loop.
function reverseString(str) {
  let result = "";

  for (let i = str.length - 1; i >= 0; i--) {
    result += str[i];
  }

  return result;
}

console.log(reverseString("hello"));
Output:
olleh
